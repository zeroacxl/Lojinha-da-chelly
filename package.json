{
  "name": "chelly-shop",
  "version": "2.0.0",
  "private": true,
  "description": "Loja de cosméticos, perfumes e essências em Rio Branco - AC. PWA instalável, otimizada para qualquer aparelho.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/run-tests.mjs",
    "audit": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
