.env
.env.*
!.env.example

# ── Editores / SO ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Logs e caches de ferramenta ─────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
coverage/
*.tsbuildinfo

# ── Diversos ────────────────────────────────────────────────────────────
.vercel
.netlify
.firebase/
*.tmp
