# ── Dependências ────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build (gerado por `npm run build`; nunca versionar) ─────────────────
dist/
dist-ssr/
build/
out/
*.local

# ── Service worker gerado em dev pelo vite-plugin-pwa ───────────────────
dev-dist/
sw.js
workbox-*.js

# ── Ambiente / segredos ─────────────────────────────────────────────────
