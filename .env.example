# Copie este arquivo para `.env` e preencha.
# O `.env` está no .gitignore — nunca sobe para o repositório.
#
# ATENÇÃO: tudo que começa com VITE_ vai para o bundle PÚBLICO do site.
# Nunca coloque aqui chave privada, senha de painel nem token de API.

# ── Domínio ─────────────────────────────────────────────────────────────
# Usado em canonical, Open Graph, sitemap e dados estruturados.
# Sem isso, a loja usa o valor padrão em src/config/site.ts.
VITE_SITE_URL=https://lojinha-da-chelly.vercel.app

# ── Google AdSense ──────────────────────────────────────────────────────
# Seu ID de editor (AdSense -> Configurações -> Conta -> ID do editor).
# Enquanto estiver vazio, NENHUM anúncio é carregado e nenhum espaço é
# reservado na página — a loja fica exatamente como era antes.
VITE_ADSENSE_CLIENT=

# Slots dos blocos (opcional). Deixe vazio para usar blocos automáticos.
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_FEED=
VITE_ADSENSE_SLOT_BOTTOM=

# ── Redes sociais ───────────────────────────────────────────────────────
# Se preenchido, o botão "Seguir no Instagram" aparece na central de
# atendimento e no rodapé. Vazio = botão não é renderizado.
VITE_INSTAGRAM_URL=
